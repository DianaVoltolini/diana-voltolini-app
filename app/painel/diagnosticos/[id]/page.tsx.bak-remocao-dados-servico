function asRecord(
  value: unknown,
): JsonRecord {
  return typeof value ===
      "object" &&
    value !== null &&
    !Array.isArray(value)
    ? value as JsonRecord
    : {};
}

function hasText(
  value: unknown,
) {
  return (
    typeof value ===
      "string" &&
    value.trim().length >
      0
  );
}

function isQuestionnaireReadyForReview(
  answers: unknown,
  documentCount: number,
) {
  const root =
    asRecord(answers);

  const express =
    asRecord(
      root.express,
    );

  const company =
    asRecord(
      express.company,
    );

  const preparation =
    asRecord(
      express.preparation,
    );

  const guidance =
    asRecord(
      express.guidance,
    );

  const companyComplete =
    [
      company.legalName,
      company.cnpj,
      company.city,
      company.state,
      company.mainActivity,
      company.taxRegime,
      company.contactName,
      company.contactValue,
      company.businessContext,
    ].every(hasText);

  const preparationComplete =
    [
      preparation.erpName,
      preparation.ibsCbsConfiguration,
      preparation.accountingGuidance,
    ].every(hasText);

  const guidanceComplete =
    guidance.completed ===
      true &&
    guidance.informationConfirmation ===
      true;

  return (
    companyComplete &&
    preparationComplete &&
    documentCount >
      0 &&
    guidanceComplete
  );
}

