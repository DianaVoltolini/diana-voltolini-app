  const { id } =
    await params;

  const supabase =
    await createClient();

  const {
    data:
      claimsData,
  } =
    await supabase.auth
      .getClaims();

  const userId =
    typeof claimsData?.claims?.sub ===
    "string"
      ? claimsData.claims.sub
      : null;

  if (!userId) {
    redirect(
      "/login",
    );
  }

  const {
    data:
      diagnostic,

    error:
      diagnosticError,
  } =
    await supabase
      .from(
