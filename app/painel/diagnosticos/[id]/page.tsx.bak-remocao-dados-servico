        )
        .eq(
          "id",
          diagnostic.company_id,
        )
        .maybeSingle(),

      supabase
        .from(
          "diagnostic_questionnaires",
        )
        .select(
          `
            id,
            answers,
            submitted_at,
            updated_at
          `,
        )
        .eq(
          "diagnostic_id",
          diagnostic.id,
        )
        .maybeSingle(),

      supabase
        .from(
          "diagnostic_documents",
        )
        .select(
          "id",
          {
            count:
              "exact",

            head:
              true,
          },
        )
        .eq(
          "diagnostic_id",
          diagnostic.id,
        )
        .eq(
          "counts_toward_limit",
          true,
        )
        .neq(
          "status",
