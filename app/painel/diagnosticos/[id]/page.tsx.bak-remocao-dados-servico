function formatDate(
  value:
    | string
    | null
    | undefined,
) {
  if (!value) {
    return "Não definido";
  }

  return new Intl.DateTimeFormat(
    "pt-BR",
    {
      timeZone:
        "America/Sao_Paulo",
    },
  ).format(
    new Date(value),
  );
}

function formatDateTime(
  value:
    | string
    | null
    | undefined,
) {
  if (!value) {
    return "Não informado";
  }

  return new Intl.DateTimeFormat(
    "pt-BR",
    {
      dateStyle:
        "short",

      timeStyle:
        "short",

      timeZone:
        "America/Sao_Paulo",
    },
  ).format(
    new Date(value),
  );
}

function formatCurrency(
  valueInCents:
    | number
    | null
    | undefined,
) {
  if (
    valueInCents ===
      null ||
    valueInCents ===
      undefined
  ) {
    return "Não informado";
  }

  return new Intl.NumberFormat(
    "pt-BR",
    {
      style:
        "currency",

      currency:
        "BRL",
    },
  ).format(
    valueInCents /
      100,
  );
}

function getActionHref(
  diagnosticId: string,
  target: ActionTarget,
) {
  if (
    target ===
    "questionario"
  ) {
    return `/painel/diagnosticos/${diagnosticId}/questionario-expresso`;
  }

  if (
    target ===
    "revisao"
  ) {
    return `/painel/diagnosticos/${diagnosticId}/questionario-expresso/revisao`;
  }

  if (
    target ===
    "documentos"
  ) {
    return `/painel/diagnosticos/${diagnosticId}/documentos`;
  }

  if (
    target ===
    "mensagens"
  ) {
    return `/painel/diagnosticos/${diagnosticId}#mensagens`;
  }

  if (
    target ===
    "resultado"
  ) {
    return `/painel/diagnosticos/${diagnosticId}/resultado`;
  }

  return null;
}

export default async function DiagnosticPage({
  params,
